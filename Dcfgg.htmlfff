<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>GÖKTÜRK ONLINE V65</title>
    <script src="https://www.gstatic.com/firebasejs/9.0.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.0.0/firebase-database-compat.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root { --gold: #ffd700; --bg: #050505; --card: #121214; --cyan: #00f2ff; --red: #ff3333; --legend: #ff8000; }
        * { box-sizing: border-box; font-family: 'Orbitron', sans-serif; transition: 0.2s; }
        body { margin: 0; background: var(--bg); color: #e0e0e0; height: 100vh; overflow: hidden; }
        .container { width: 100%; max-width: 450px; height: 100vh; margin: auto; display: flex; flex-direction: column; background: #000; position: relative; border-left: 1px solid #222; border-right: 1px solid #222; }
        
        #global-announcement { position: fixed; top: -100px; left: 0; width: 100%; background: linear-gradient(90deg, #900, var(--red)); color: #fff; text-align: center; padding: 15px; font-weight: bold; z-index: 10001; border-bottom: 3px solid var(--gold); }
        .header { display: flex; justify-content: space-between; padding: 15px; background: #080808; border-bottom: 2px solid var(--gold); font-size: 13px; }
        .panel { display: none; padding: 15px; height: calc(100vh - 155px); overflow-y: auto; padding-bottom: 90px; }
        .active { display: block; }
        .card { background: var(--card); border: 1px solid #222; padding: 12px; border-radius: 12px; margin-bottom: 10px; }
        
        .btn-gold { background: var(--gold); color: #000; border: none; padding: 10px; border-radius: 8px; font-weight: bold; width: 100%; cursor: pointer; }
        .btn-red { background: var(--red); color: #fff; border: none; padding: 8px; border-radius: 8px; cursor: pointer; width: 100%; margin-top: 5px; }
        
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; }
        .slot { aspect-ratio: 1; background: #151518; border: 1px solid #333; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 20px; position: relative; }
        .equipped { border: 2px solid var(--cyan); box-shadow: 0 0 10px var(--cyan); }

        .bottom-nav { position: absolute; bottom: 0; width: 100%; display: grid; grid-template-columns: repeat(6, 1fr); height: 80px; background: #080808; border-top: 1px solid #222; }
        .nav-item { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #555; font-size: 8px; cursor: pointer; }
        .nav-item.active { color: var(--gold); }
        .auth-input { width: 100%; padding: 12px; margin: 5px 0; background: #111; border: 1px solid #333; color: white; border-radius: 8px; }
    </style>
</head>
<body>

<div id="global-announcement">🔱 HAKAN FERMANI!</div>

<div id="auth-screen" style="position:fixed; inset:0; background:#000; z-index:9999; padding:20px; display:flex; flex-direction:column; justify-content:center;">
    <h1 style="color:var(--gold); text-align:center;">GÖKTÜRK ONLINE</h1>
    <div class="card" style="border:1px solid var(--gold); padding:20px;">
        <h3>Otağa Giriş</h3>
        <input type="text" id="l-u" class="auth-input" placeholder="Alp Adı">
        <input type="password" id="l-p" class="auth-input" placeholder="Şifre">
        <button onclick="handleAuth()" class="btn-gold" style="margin-top:10px;">SEFERE BAŞLA</button>
        <p style="font-size:10px; color:#555; text-align:center; margin-top:10px;">Veriler Firebase Online Veritabanına Kaydedilir.</p>
    </div>
</div>

<div class="container" id="game-ui" style="display:none;">
    <div class="header">
        <div>🪙 <span id="v-gold">0</span></div>
        <div style="color:var(--cyan);">LVL <span id="v-lvl">1</span></div>
        <div style="color:var(--red);">⚔️ <span id="v-pow">0</span></div>
    </div>

    <div id="p-home" class="panel active">
        <div class="card" style="text-align:center;">
            <div style="width:70px; height:70px; border:2px solid var(--gold); border-radius:50%; margin:auto; overflow:hidden;">
                <img id="v-img" src="https://via.placeholder.com/70" style="width:100%; height:100%; object-fit:cover;">
            </div>
            <h3 id="v-name" style="margin:10px 0 0 0;">---</h3>
            <div id="v-unvan" style="color:var(--legend); font-size:12px;">Alp</div>
        </div>

        <div id="admin-panel" style="display:none;" class="card">
            <h4 style="color:var(--red); margin:0 0 10px 0;">🔱 HAKAN YÖNETİMİ</h4>
            <input type="text" id="adm-msg" class="auth-input" placeholder="Tüm dünyaya ferman yolla...">
            <button onclick="sendGlobalDuyuru()" class="btn-red">FERMANI YAYINLA</button>
        </div>

        <div class="card" style="border:1px solid var(--cyan);">
            <h4 style="color:var(--cyan); margin:0;">🛒 PAZAR BİLGİ</h4>
            <small>Pazar ve Seferler Online senkronizedir.</small>
        </div>
    </div>

    <div id="p-chat" class="panel">
        <div id="chat-box" style="height:350px; background:#080808; border:1px solid #222; overflow-y:auto; padding:10px; font-size:12px;"></div>
        <div style="display:flex; gap:5px; margin-top:10px;">
            <input type="text" id="chat-in" class="auth-input" style="flex:1; margin:0;" placeholder="Mesaj yaz...">
            <button onclick="sendMsg()" class="btn-gold" style="width:70px; margin:0;">AT</button>
        </div>
    </div>

    <div id="p-rank" class="panel">
        <h3 style="color:var(--gold); text-align:center;">🏆 ŞAN KÜRSÜSÜ</h3>
        <div id="rank-list"></div>
    </div>

    <div class="bottom-nav">
        <div class="nav-item active" onclick="showP('p-home',this)"><i class="fas fa-home fa-lg"></i><span>Otağ</span></div>
        <div class="nav-item" onclick="showP('p-chat',this)"><i class="fas fa-comments fa-lg"></i><span>Divan</span></div>
        <div class="nav-item" onclick="showP('p-rank',this)"><i class="fas fa-medal fa-lg"></i><span>Kürsü</span></div>
        <div class="nav-item"><i class="fas fa-khanda fa-lg"></i><span>Sefer</span></div>
        <div class="nav-item"><i class="fas fa-shopping-cart fa-lg"></i><span>Pazar</span></div>
        <div class="nav-item"><i class="fas fa-box fa-lg"></i><span>Hazine</span></div>
    </div>
</div>

<script>
    // --- SİZİN FİREBASE BİLGİLERİNİZ ---
    const firebaseConfig = {
      apiKey: "AIzaSyAxXHK-3j-cnoM_7k1svrBJnEqFrvHaAw0",
      authDomain: "gokturkbeta-1.firebaseapp.com",
      projectId: "gokturkbeta-1",
      storageBucket: "gokturkbeta-1.firebasestorage.app",
      messagingSenderId: "859191608412",
      appId: "1:859191608412:web:7f440e39d081ff7e6e5299",
      databaseURL: "https://gokturkbeta-1-default-rtdb.firebaseio.com" // Eklenen DB URL
    };

    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();
    let p = null;

    // --- GİRİŞ & KAYIT (ONLINE) ---
    function handleAuth() {
        let u = document.getElementById('l-u').value.trim().toLowerCase();
        let pw = document.getElementById('l-p').value.trim();
        if(!u || !pw) return alert("Bilgileri girin!");

        db.ref('players/' + u).once('value', (snap) => {
            let data = snap.val();
            if(data) {
                if(data.pw === pw) { 
                    p = data; 
                    if(u === "ebuinc") p.isAdmin = true;
                    loginSuccess(); 
                } else alert("Hatalı Şifre!");
            } else {
                // Otomatik Kayıt
                p = { u: u, pw: pw, gold: 20000, lvl: 1, unvan: "Yeni Alp", isAdmin: (u==="ebuinc") };
                db.ref('players/' + u).set(p);
                loginSuccess();
            }
        });
    }

    function loginSuccess() {
        document.getElementById('auth-screen').style.display='none';
        document.getElementById('game-ui').style.display='flex';
        if(p.isAdmin) document.getElementById('admin-panel').style.display='block';
        startOnlineSync();
    }

    // --- ONLINE CHAT ---
    function sendMsg() {
        let text = document.getElementById('chat-in').value.trim();
        if(!text) return;
        if(p.isAdmin && text.startsWith("/gold")) { 
            p.gold += 50000; updateP(); 
        } else {
            db.ref('messages').push({ u: p.u, msg: text, isAdmin: p.isAdmin || false, time: Date.now() });
        }
        document.getElementById('chat-in').value = "";
    }

    function startOnlineSync() {
        // Chat Dinleyici
        db.ref('messages').limitToLast(20).on('value', (snap) => {
            let data = snap.val();
            let cb = document.getElementById('chat-box');
            cb.innerHTML = "";
            for(let id in data) {
                let m = data[id];
                cb.innerHTML += `<div style="margin-bottom:5px;"><b style="${m.isAdmin?'color:red':'color:var(--gold)'}">${m.u}:</b> ${m.msg}</div>`;
            }
            cb.scrollTop = cb.scrollHeight;
        });

        // Kürsü Dinleyici
        db.ref('players').on('value', (snap) => {
            let list = [];
            snap.forEach(x => { list.push(x.val()); });
            list.sort((a,b) => b.gold - a.gold);
            document.getElementById('rank-list').innerHTML = list.map((u,i) => `
                <div class="card" style="display:flex; justify-content:space-between; align-items:center;">
                    <span><b>${i+1}.</b> ${u.u}</span>
                    <span style="color:var(--gold)">${u.gold.toLocaleString()} 🪙</span>
                </div>`).join('');
        });

        // Duyuru Dinleyici
        db.ref('announcement').on('value', (snap) => {
            let m = snap.val();
            if(m) {
                let b = document.getElementById('global-announcement');
                b.innerText = "🔱 " + m; b.style.top = "0";
                setTimeout(() => b.style.top = "-100px", 6000);
            }
        });

        setInterval(updateUI, 1000);
    }

    function sendGlobalDuyuru() {
        let m = document.getElementById('adm-msg').value;
        if(m) { db.ref('announcement').set(m); document.getElementById('adm-msg').value=""; }
    }

    function updateP() { db.ref('players/' + p.u).update(p); }

    function updateUI() {
        document.getElementById('v-gold').innerText = p.gold.toLocaleString();
        document.getElementById('v-lvl').innerText = p.lvl;
        document.getElementById('v-name').innerText = p.u.toUpperCase();
        document.getElementById('v-unvan').innerText = p.isAdmin ? "BAŞ KAĞAN" : p.unvan;
    }

    function showP(id, el) {
        document.querySelectorAll('.panel').forEach(x => x.classList.remove('active'));
        document.getElementById(id).classList.add('active');
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
        el.classList.add('active');
    }
</script>
</body>
</html>
